<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>{{ doc.number }}</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selektory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 9.5pt; color: #15131D; }
    .doc-title { font-size: 14pt; font-weight: bold; }
    .doc-number { font-family: montserrat, dejavusans, sans-serif; font-size: 12pt; font-weight: bold; text-align: right; }
    .head-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; border-bottom: 0.6pt solid #333; }
    .head-table td { vertical-align: top; padding-bottom: 2mm; }
    .supplier-label { color: #777; font-size: 7.5pt; }
    .body-table { width: 100%; border-collapse: collapse; }
    .body-table td { padding: 2mm 1.5mm; border-bottom: 0.2pt solid #ddd; vertical-align: top; }
    .field-label { color: #777; font-size: 8pt; width: 40mm; }
    .amount-cell { font-family: montserrat, dejavusans, sans-serif; font-size: 13pt; font-weight: bold; }
    .words { font-style: italic; }
    .sign-table { width: 100%; border-collapse: collapse; margin-top: 12mm; }
    .sign-table td { width: 50%; text-align: center; font-size: 8pt; color: #555; padding-top: 10mm; }
    .sign-line { border-top: 0.4pt solid #999; margin: 0 10mm; padding-top: 1.5mm; }
</style>
</head>
<body>
    <table class="head-table">
        <tr>
            <td>
                <div class="doc-title">{{ is_income ? 'Příjmový pokladní doklad' : 'Výdajový pokladní doklad' }}</div>
                <div class="supplier-label">Vystavil</div>
                <div>{{ supplier.company_name }}</div>
                <div>{{ supplier.street }}, {{ supplier.zip }} {{ supplier.city }}</div>
                <div>IČO: {{ supplier.ic }}{% if supplier.dic %} · DIČ: {{ supplier.dic }}{% endif %}</div>
            </td>
            <td>
                <div class="doc-number">{{ doc.number }}</div>
                <div style="text-align: right;">Vyhotoveno: <strong>{{ doc.issue_date|cz_date }}</strong></div>
                {% if doc.accounting_date and doc.accounting_date != doc.issue_date %}
                <div style="text-align: right; font-size: 8pt;">Uskutečněno: {{ doc.accounting_date|cz_date }}</div>
                {% endif %}
                {% if doc.status == 'storno' %}
                <div style="text-align: right; color: #b00020; font-weight: bold;">STORNOVÁNO{% if doc.storno_by_number %} dokladem {{ doc.storno_by_number }}{% endif %}</div>
                {% elseif doc.storno_of_number %}
                <div style="text-align: right; color: #b00020; font-weight: bold;">STORNO dokladu {{ doc.storno_of_number }}</div>
                {% endif %}
            </td>
        </tr>
    </table>

    <table class="body-table">
        <tr>
            <td class="field-label">{{ is_income ? 'Přijato od' : 'Vyplaceno komu' }}</td>
            <td>
                {{ doc.counterparty ?: '—' }}
                {%- if doc.counterparty_ico %} · IČO {{ doc.counterparty_ico }}{% endif %}
                {% if doc.counterparty_address %}<br><span style="font-size: 8pt; color: #555;">{{ doc.counterparty_address }}</span>{% endif %}
            </td>
        </tr>
        <tr>
            <td class="field-label">Účel platby</td>
            <td>{{ doc.description ?: '—' }}{% if doc.invoice_varsymbol %} (faktura VS {{ doc.invoice_varsymbol }}){% endif %}{% if doc.purchase_varsymbol %} (přijatá faktura {{ doc.purchase_varsymbol }}){% endif %}</td>
        </tr>
        {% if doc.note %}
        <tr>
            <td class="field-label">Poznámka</td>
            <td style="font-size: 8.5pt;">{{ doc.note }}</td>
        </tr>
        {% endif %}
        <tr>
            <td class="field-label">Částka</td>
            <td class="amount-cell">{{ doc.amount|cz_money }} {{ doc.currency }}</td>
        </tr>
        <tr>
            <td class="field-label">Slovy</td>
            <td class="words">{{ amount_words }}</td>
        </tr>
        {% if doc.is_tax_document and doc.vat_breakdown %}
        <tr>
            <td class="field-label">Rozpis DPH<br><span style="font-size: 7pt;">(zjednodušený daňový doklad, § 30a ZDPH)</span></td>
            <td>
                <table style="border-collapse: collapse; width: 90mm; font-size: 8.5pt;">
                    <tr>
                        <td style="color:#777; border-bottom: 0.2pt solid #ccc;">Sazba</td>
                        <td style="color:#777; border-bottom: 0.2pt solid #ccc; text-align: right;">Základ</td>
                        <td style="color:#777; border-bottom: 0.2pt solid #ccc; text-align: right;">DPH</td>
                    </tr>
                    {% for b in doc.vat_breakdown %}
                    <tr>
                        <td>{{ b.rate }} %</td>
                        <td style="text-align: right;">{{ b.base|cz_money }}</td>
                        <td style="text-align: right;">{{ b.vat|cz_money }}</td>
                    </tr>
                    {% endfor %}
                </table>
            </td>
        </tr>
        {% endif %}
    </table>

    <table class="sign-table">
        <tr>
            <td style="width: 33%;"><div class="sign-line">Vystavil{% if doc.issued_by %}<br><strong>{{ doc.issued_by }}</strong>{% endif %}</div></td>
            <td style="width: 33%;"><div class="sign-line">Schválil{% if doc.approved_by %}<br><strong>{{ doc.approved_by }}</strong>{% endif %}</div></td>
            <td style="width: 33%;"><div class="sign-line">{{ is_income ? 'Přijal' : 'Vydal / přijal' }}{% if doc.received_by %}<br><strong>{{ doc.received_by }}</strong>{% endif %}</div></td>
        </tr>
    </table>
</body>
</html>
